#!/bin/sh
# SPDX-License-Identifier: MIT
# Demo mode (normal boot, not autotest): loads the simulated chip (i2c-stub at 0x48) set to 25 C,
# loads the hvac_temp driver and softdog, creates the device, and starts hvacd in the background with
# /etc/hvacd.conf, logging to /var/log/hvacd.log. Modbus TCP is then on port 502 (5020 on the host).
# Does nothing when the kernel command line contains hvac_autotest=1.
set -eu

CHIP_ADDR=0x48
TEMP_25C_SWAPPED=0x0019 # chip register 0x1900 = 25 C, byte-swapped for i2c-stub (PROJECT_PLAN 4.1)
PIDFILE=/var/run/hvacd.pid
LOGFILE=/var/log/hvacd.log

is_autotest() {
	grep -qw "hvac_autotest=1" /proc/cmdline
}

stub_bus() {
	for d in /sys/bus/i2c/devices/i2c-*; do
		if [ "$(cat "$d/name")" = "SMBus stub driver" ]; then
			basename "$d" | sed 's/i2c-//'
			return 0
		fi
	done
	return 1
}

start() {
	if is_autotest; then
		echo "S90hvac-demo: autotest mode, demo not started"
		return 0
	fi
	echo "S90hvac-demo: loading i2c-stub at ${CHIP_ADDR} and the hvac_temp driver"
	modprobe i2c-stub chip_addr="${CHIP_ADDR}"
	bus="$(stub_bus)"
	i2cset -y "${bus}" "${CHIP_ADDR}" 0x00 "${TEMP_25C_SWAPPED}" w
	modprobe hvac_temp
	echo "hvac_temp ${CHIP_ADDR}" > "/sys/bus/i2c/devices/i2c-${bus}/new_device"
	modprobe softdog # provides /dev/watchdog for hvacd's watchdog supervision (Ext 1)
	echo "S90hvac-demo: starting hvacd (log: ${LOGFILE})"
	start-stop-daemon -S -b -m -p "${PIDFILE}" -x /bin/sh -- \
		-c "exec /usr/sbin/hvacd --config /etc/hvacd.conf >> ${LOGFILE} 2>&1"
}

stop() {
	if [ -f "${PIDFILE}" ]; then
		start-stop-daemon -K -p "${PIDFILE}" -s TERM || true
		rm -f "${PIDFILE}"
	fi
}

case "${1:-start}" in
start) start ;;
stop) stop ;;
restart | reload)
	stop
	start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
